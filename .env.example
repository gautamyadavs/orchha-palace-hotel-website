# Public site configuration
DEPLOY_TARGET=local
PUBLIC_SITE_URL=https://orchhapalace.com
PUBLIC_SITE_STATUS=staging
PUBLIC_MEDIA_PREVIEW=false
PUBLIC_BOOKING_URL=https://bookingengine.maximojo.com/?hid=India54468d49-cd5b-4af2-a615-303eda366eea
PUBLIC_GTM_ID=
PUBLIC_TURNSTILE_SITE_KEY=
