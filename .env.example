# Optional Sanity content source. Local verified content is used without these.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Cloudflare Worker secrets: set with `wrangler secret put NAME`
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Cloudflare Worker variables (also declared in wrangler.jsonc)
LEAD_ALLOWED_ORIGINS=https://gautamyadavs.github.io,https://orchhapalace.com,https://www.orchhapalace.com
