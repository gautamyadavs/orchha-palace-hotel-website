---
import { Icon } from "astro-icon/components";

type Props = {
  eyebrow?: string;
  title: string;
  copy: string;
  image: string;
  mobileImage?: string;
  alt: string;
  position?: string;
  cta?: { label: string; href: string };
};
const { eyebrow, title, copy, image, mobileImage, alt, position = "50% 50%", cta } = Astro.props;
---

<section class="page-hero">
  <picture class="page-hero__media">
    {mobileImage && <source media="(max-width: 640px)" srcset={mobileImage} />}
    <img src={image} alt={alt} width="1800" height="1100" loading="eager" fetchpriority="high" decoding="sync" style={`object-position:${position}`} />
  </picture>
  <div class="page-hero__shade" aria-hidden="true"></div>
  <div class="page-hero__content shell">
    {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{copy}</p>
    {cta && (
      <a class="button button--light page-hero__action" href={cta.href}>
        {cta.label} <Icon name="ph:arrow-right" size={18} aria-hidden="true" />
      </a>
    )}
  </div>
</section>
