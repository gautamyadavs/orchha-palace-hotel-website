---
import { Icon } from "astro-icon/components";
import { contact } from "@/data/site";
import { withBase } from "@/lib/paths";
import type { JourneyMode } from "@/lib/types";

type Props = { journey?: JourneyMode };
const { journey = "stay" } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-intro shell">
    <p class="eyebrow eyebrow--light">{journey === "event" ? "Your occasion in Orchha" : journey === "assisted-suite" ? "A private stay in Orchha" : "Your stay in Orchha"}</p>
    <h2>{journey === "event" ? <>Imagine it here.<br />Plan it with us.</> : journey === "assisted-suite" ? <>Reserve personally.<br />Stay exceptionally.</> : <>Arrive curious.<br />Leave restored.</>}</h2>
    {journey === "event" ? (
      <a class="text-link text-link--light" href="#event-enquiry">Send an event enquiry <Icon name="ph:arrow-up-right" size={18} aria-hidden="true" /></a>
    ) : journey === "assisted-suite" ? (
      <a class="text-link text-link--light" href={contact.primaryPhoneHref} data-track="assisted_reservation_call_clicked" data-room="presidential-suite" data-source="footer">Call to reserve <Icon name="ph:phone" size={18} aria-hidden="true" /></a>
    ) : (
      <a class="text-link text-link--light" href="#availability" data-booking-open data-booking-source="footer">Check availability <Icon name="ph:arrow-up-right" size={18} aria-hidden="true" /></a>
    )}
  </div>
  <div class="footer-grid shell">
    <div>
      <p class="footer-label">Find us</p>
      <address>{contact.address}</address>
      <a href={contact.maps} target="_blank" rel="noreferrer" data-track="directions_clicked">Open in Google Maps</a>
    </div>
    <div>
      <p class="footer-label">Stay</p>
      <a href={withBase("/rooms/")}>Rooms & suites</a>
      <a href={withBase("/hotel-amenities/")}>Hotel & amenities</a>
      <a href={withBase("/dining/")}>Dining</a>
      <a href={withBase("/gallery/")}>Gallery</a>
      <a href={withBase("/offers/")}>Offers</a>
    </div>
    <div>
      <p class="footer-label">Gather</p>
      <a href={withBase("/weddings-events/")}>Weddings & events</a>
      <a href={withBase("/explore-orchha/")}>Explore Orchha</a>
      <a href={withBase("/contact/")}>Contact</a>
      <a href={journey === "event" ? contact.whatsapp.event : journey === "assisted-suite" ? contact.whatsapp.presidentialSuite : contact.whatsapp.stay} target="_blank" rel="noreferrer" data-track={journey === "event" ? "event_whatsapp_clicked" : journey === "assisted-suite" ? "assisted_reservation_whatsapp_clicked" : "whatsapp_clicked"} data-room={journey === "assisted-suite" ? "presidential-suite" : undefined}>WhatsApp</a>
    </div>
    <div>
      <p class="footer-label">Contact</p>
      <a href={contact.primaryPhoneHref} data-track="call_clicked">{contact.primaryPhone}</a>
      <a href={`mailto:${journey === "event" ? contact.salesEmail : contact.reservationsEmail}`}>{journey === "event" ? contact.salesEmail : contact.reservationsEmail}</a>
    </div>
  </div>
  <div class="footer-bottom shell">
    <p>© {new Date().getFullYear()} Orchha Palace Hotel & Convention Centre</p>
    <div>
      <a href={withBase("/privacy/")}>Privacy</a>
      <a href={withBase("/terms/")}>Terms</a>
      <a href={withBase("/booking-policies/")}>Booking policies</a>
    </div>
  </div>
</footer>
