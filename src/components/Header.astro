---
import { Icon } from "astro-icon/components";
import { contact } from "@/data/site";
import { withBase } from "@/lib/paths";
import type { JourneyMode } from "@/lib/types";

type Props = { journey?: JourneyMode };
const { journey = "stay" } = Astro.props;

const navGroups = [
  {
    label: "Stay & dine",
    items: [
      { href: withBase("/rooms/"), label: "Rooms & suites" },
      { href: withBase("/dining/"), label: "Dining" },
      { href: withBase("/hotel-amenities/"), label: "Hotel & amenities" }
    ]
  },
  {
    label: "Gather & explore",
    items: [
      { href: withBase("/weddings-events/"), label: "Weddings & events" },
      { href: withBase("/explore-orchha/"), label: "Explore Orchha" },
      { href: withBase("/gallery/"), label: "Gallery" }
    ]
  },
  {
    label: "Plan your visit",
    items: [
      { href: withBase("/offers/"), label: "Offers" },
      { href: withBase("/contact/"), label: "Contact & directions" }
    ]
  }
];

const primaryNav = [
  navGroups[0].items[0],
  navGroups[0].items[1],
  navGroups[1].items[0],
  navGroups[0].items[2],
  navGroups[1].items[1]
];

const normalizePath = (path: string) => path.replace(/\/$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => {
  const target = normalizePath(href);
  return currentPath === target || (target !== "/" && currentPath.startsWith(`${target}/`));
};
---

<header class="site-header" data-header>
  <a class="wordmark" href={withBase("/")} aria-label="Orchha Palace home">
    <span class="wordmark__name">Orchha Palace</span>
    <span class="wordmark__sub">Hotel & Convention Centre</span>
  </a>

  <nav class="desktop-nav" aria-label="Primary navigation">
    {primaryNav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
  </nav>

  <div class="header-actions">
    <a class="header-call" href={contact.primaryPhoneHref} data-track={journey === "event" ? "event_call_clicked" : journey === "assisted-suite" ? "assisted_reservation_call_clicked" : "call_clicked"} data-room={journey === "assisted-suite" ? "presidential-suite" : undefined} data-source="header_icon" aria-label={journey === "event" ? "Call the events team" : journey === "assisted-suite" ? "Call to reserve the Presidential Suite" : "Call Orchha Palace"}>
      <Icon name="ph:phone" size={20} aria-hidden="true" />
    </a>
    {journey === "event" ? (
      <a class="button button--primary button--small header-book" href="#event-enquiry">
        Plan an event <Icon name="ph:arrow-down" size={17} aria-hidden="true" />
      </a>
    ) : journey === "assisted-suite" ? (
      <a class="button button--primary button--small header-book" href={contact.primaryPhoneHref} data-track="assisted_reservation_call_clicked" data-room="presidential-suite" data-source="header">
        Call to reserve <Icon name="ph:phone" size={17} aria-hidden="true" />
      </a>
    ) : (
      <a class="button button--primary button--small header-book" href="#availability" data-booking-open data-booking-source="header">
        Book a room <Icon name="ph:arrow-right" size={17} aria-hidden="true" />
      </a>
    )}
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      <span>Menu</span>
      <Icon name="ph:list" size={22} aria-hidden="true" />
    </button>
  </div>

  <div class="menu-drawer" id="site-menu" role="dialog" aria-modal="true" aria-label="Site navigation" aria-hidden="true" data-menu>
    <div class="menu-drawer__top">
      <span class="menu-kicker">Orchha Palace</span>
      <button class="icon-button" type="button" aria-label="Close menu" data-menu-close>
        <Icon name="ph:x" size={26} aria-hidden="true" />
      </button>
    </div>
    <nav class="menu-nav" aria-label="Site navigation">
      {navGroups.map((group) => (
        <div class="menu-nav__group">
          <p>{group.label}</p>
          {group.items.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
              <Icon name="ph:arrow-up-right" size={18} aria-hidden="true" />
            </a>
          ))}
        </div>
      ))}
    </nav>
    <div class="menu-drawer__footer">
      {journey === "event" ? (
        <a class="button button--light" href="#event-enquiry">
          Send an event enquiry <Icon name="ph:arrow-down" size={18} aria-hidden="true" />
        </a>
      ) : journey === "assisted-suite" ? (
        <a class="button button--light" href={contact.whatsapp.presidentialSuite} target="_blank" rel="noreferrer" data-track="assisted_reservation_whatsapp_clicked" data-room="presidential-suite">
          WhatsApp about the suite <Icon name="ph:whatsapp-logo" size={18} aria-hidden="true" />
        </a>
      ) : (
        <a class="button button--light" href="#availability" data-booking-open data-booking-source="menu">
          Check availability <Icon name="ph:calendar-check" size={18} aria-hidden="true" />
        </a>
      )}
      <div class="menu-drawer__contact">
        <a href={contact.primaryPhoneHref}>{contact.primaryPhone}</a>
        <a href={`mailto:${journey === "event" ? contact.salesEmail : contact.reservationsEmail}`}>{journey === "event" ? contact.salesEmail : contact.reservationsEmail}</a>
      </div>
    </div>
  </div>
</header>
