---
import { Icon } from "astro-icon/components";

type RoomIntent = {
  slug: string;
  name: string;
  code?: string;
};

type Props = {
  bookingUrl: string;
  source: string;
  room?: RoomIntent;
  variant?: "inline" | "sheet";
};

const { bookingUrl, source, room, variant = "inline" } = Astro.props;
---

<form
  class:list={["booking-form", `booking-form--${variant}`]}
  data-booking-form
  data-booking-url={bookingUrl}
  data-booking-source={source}
  data-booking-room={room?.slug || ""}
  data-booking-room-name={room?.name || ""}
  data-booking-room-code={room?.code || ""}
  novalidate
>
  <div class="booking-form__room" data-booking-room-preference hidden={!room}>
    <Icon name="ph:bed" size={20} aria-hidden="true" />
    <span>Exploring: <strong data-booking-room-name>{room?.name}</strong>. Confirm room and bed choice in live booking.</span>
    <button type="button" data-booking-room-clear hidden={!room}>View every room</button>
  </div>

  <div class="booking-form__grid">
    <label class="booking-form__field">
      <span><Icon name="ph:calendar-blank" size={19} aria-hidden="true" /> Check in</span>
      <input type="date" name="checkIn" required />
    </label>

    <label class="booking-form__field">
      <span><Icon name="ph:calendar-check" size={19} aria-hidden="true" /> Check out</span>
      <input type="date" name="checkOut" required />
    </label>

    <label class="booking-form__field">
      <span><Icon name="ph:user" size={19} aria-hidden="true" /> Adults</span>
      <select name="adults" aria-label="Adults">
        {Array.from({ length: 12 }, (_, index) => index + 1).map((count) => (
          <option value={count} selected={count === 2}>{count}</option>
        ))}
      </select>
    </label>

    <label class="booking-form__field">
      <span><Icon name="ph:baby" size={19} aria-hidden="true" /> Children</span>
      <select name="children" aria-label="Children">
        {Array.from({ length: 9 }, (_, index) => index).map((count) => (
          <option value={count} selected={count === 0}>{count}</option>
        ))}
      </select>
    </label>

    <button class="button button--primary booking-form__submit" type="submit">
      Check live rates <Icon name="ph:arrow-right" size={19} aria-hidden="true" />
    </button>
  </div>

  <details class="booking-form__promo">
    <summary>Add a promo code</summary>
    <label>
      <span>Promo code</span>
      <input type="text" name="promoCode" inputmode="text" autocomplete="off" maxlength="40" />
    </label>
  </details>

  <p class="booking-summary" data-booking-summary aria-live="polite">Choose your dates to see the length of your stay.</p>
  <p class="booking-form__note">Select your final room and bed choice in live booking. Add extra rooms there. For infants or help with child age bands, <a href="tel:+919516006201">ask reservations</a> before booking.</p>
  <p class="form-message" data-booking-message role="status" aria-live="polite"></p>
  <noscript><a class="button button--primary" href={bookingUrl}>Open the official booking engine</a></noscript>
</form>
