---
import { Icon } from "astro-icon/components";
import { contact } from "@/data/site";
import { eventTypes, eventVenueNames } from "@/lib/enquiry-options";
import { withBase } from "@/lib/paths";
import type { EventJourney } from "@/lib/types";
const { journey } = Astro.props as { journey?: EventJourney };
const options = journey === "wedding" ? eventTypes.filter(t => ["Wedding", "Engagement or reception", "Private celebration", "Other"].includes(t)) : journey === "corporate" ? eventTypes.filter(t => !["Wedding", "Engagement or reception", "Private celebration"].includes(t)) : eventTypes;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const configuredEndpoint = import.meta.env.PUBLIC_LEAD_API_URL?.trim();
const sameOriginEndpoint = import.meta.env.PUBLIC_SITE_STATUS === "production" ? withBase("/api/event-leads") : "";
const leadEndpoint = configuredEndpoint || sameOriginEndpoint;
const formEnabled = Boolean(leadEndpoint && turnstileSiteKey);
---

<form class="lead-form" data-event-lead-form data-lead-endpoint={leadEndpoint} data-lead-enabled={String(formEnabled)} novalidate>
  <fieldset class="lead-form__fields" disabled={!formEnabled}>
    <input name="journey" type="hidden" value={journey || ""} />
    <section data-lead-step="1" aria-label="Event requirements">
      <p class="step-label">1. Your event</p>
      <div class="field-grid">
        <label><span>Event type *</span><select name="eventType" required><option value="">Choose one</option>{options.map(type => <option>{type}</option>)}</select></label>
        <label><span>Tentative date (optional)</span><input name="tentativeDate" type="date" /></label>
        <label><span>{journey === "corporate" ? "Expected delegates *" : "Expected guests *"}</span><input name="guestCount" type="number" inputmode="numeric" min="2" max="5000" required /></label>
        <label><span>Preferred venue</span><select name="preferredVenue"><option value="">Help me choose</option>{eventVenueNames.filter(name => journey !== "wedding" || name !== "Boardroom").map(name => <option>{name}</option>)}</select></label>
        <label><span>Seating layout</span><select name="seatingLayout"><option value="">Help me choose</option>{["Theatre", "Banquet", "Classroom", "Boardroom", "Outdoor"].map(layout => <option>{layout}</option>)}</select></label>
        <label><span>Guest rooms needed (optional)</span><input name="guestRooms" type="number" min="0" max="500" inputmode="numeric" /></label>
        {journey !== "wedding" && <label class="field-grid__wide"><span>Organisation (optional)</span><input name="organisation" maxlength="160" autocomplete="organization" /></label>}
        {journey !== "corporate" && <label class="field-grid__wide"><span>Functions (optional)</span><input name="functions" maxlength="500" placeholder="For example: mehendi, ceremony, reception" /></label>}
        {journey !== "wedding" && <label class="field-grid__wide"><span>AV and connectivity needs (optional)</span><textarea name="avNeeds" rows="2" maxlength="500" placeholder="Presentations, microphones, video calls, internet requirements…"></textarea></label>}
        <label class="field-grid__wide"><span>Anything else to help us plan?</span><textarea name="message" rows="3" maxlength="2000" placeholder="Food, travel, accessibility or other requests"></textarea></label>
      </div>
      <div class="form-navigation" data-lead-next-wrap hidden><button class="button button--primary" type="button" data-lead-next>Continue to contact details →</button></div>
    </section>
    <section data-lead-step="2" aria-label="Contact and review">
      <p class="step-label">2. Contact & review</p>
      <div class="lead-review" data-lead-review hidden></div>
      <div class="field-grid">
        <label><span>Name *</span><input name="name" autocomplete="name" required maxlength="100" /></label>
        <label><span>Phone *</span><input name="phone" type="tel" autocomplete="tel" required minlength="7" maxlength="30" pattern={String.raw`[+\(\)\-\s0-9]{7,30}`} /></label>
        <label class="field-grid__wide"><span>Email *</span><input name="email" type="email" autocomplete="email" required maxlength="160" /></label>
      </div>
      <label class="checkbox-field"><input name="consent" type="checkbox" required /><span>I agree that Orchha Palace may contact me about this enquiry. *</span></label>
      <button class="button button--secondary" type="button" data-lead-back hidden>← Back to event details</button>
    </section>

    {formEnabled && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="compact" data-theme="light" data-action="event-enquiry"></div>}
    <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
  </fieldset>

  <div class="lead-form__submit">
    <button class="button button--primary" type="submit" disabled={!formEnabled}>
      Send event enquiry <Icon name="ph:arrow-right" size={19} aria-hidden="true" />
    </button>
    <p class="form-message" data-lead-message aria-live="polite"></p>
  </div>

  <div class="lead-form__fallback" data-lead-fallback hidden>
    <p>We could not confirm delivery, so your enquiry may not have been recorded. Please contact the sales team directly.</p>
    <a href={`mailto:${contact.salesEmail}`}>Email {contact.salesEmail}</a>
    <a href={contact.primaryPhoneHref}>Call {contact.primaryPhone}</a>
    <a href={contact.whatsapp.event} target="_blank" rel="noreferrer">Continue on WhatsApp</a>
  </div>

  {!formEnabled && (
    <div class="lead-form__unavailable">
      <p><strong>Online enquiry is temporarily unavailable.</strong> Contact the sales team directly and we will help you plan the occasion.</p>
      <a href={`mailto:${contact.salesEmail}`}>Email {contact.salesEmail}</a>
      <a href={contact.primaryPhoneHref}>Call {contact.primaryPhone}</a>
      <a href={contact.whatsapp.event} target="_blank" rel="noreferrer">Continue on WhatsApp</a>
    </div>
  )}
</form>
