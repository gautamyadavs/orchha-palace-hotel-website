---
import { Icon } from "astro-icon/components";
import { contact } from "@/data/site";
import { eventTypes, eventVenueNames } from "@/lib/enquiry-options";
import { withBase } from "@/lib/paths";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const configuredEndpoint = import.meta.env.PUBLIC_LEAD_API_URL?.trim();
const sameOriginEndpoint = import.meta.env.PUBLIC_SITE_STATUS === "production" ? withBase("/api/event-leads") : "";
const leadEndpoint = configuredEndpoint || sameOriginEndpoint;
const formEnabled = Boolean(leadEndpoint && turnstileSiteKey);
---

<form class="lead-form" data-event-lead-form data-lead-endpoint={leadEndpoint} data-lead-enabled={String(formEnabled)} novalidate>
  <fieldset class="lead-form__fields" disabled={!formEnabled}>
    <div class="field-grid">
      <label>
        <span>Name *</span>
        <input name="name" autocomplete="name" required maxlength="100" />
      </label>
      <label>
        <span>Phone *</span>
        <input name="phone" type="tel" autocomplete="tel" required maxlength="30" />
      </label>
      <label>
        <span>Email *</span>
        <input name="email" type="email" autocomplete="email" required maxlength="160" />
      </label>
      <label>
        <span>Event type *</span>
        <select name="eventType" required>
          <option value="">Choose one</option>
          {eventTypes.map((eventType) => <option value={eventType}>{eventType}</option>)}
        </select>
      </label>
      <label>
        <span>Tentative date</span>
        <input name="tentativeDate" type="date" />
      </label>
      <label>
        <span>Expected guests *</span>
        <input name="guestCount" type="number" inputmode="numeric" min="2" max="5000" value="100" required />
      </label>
      <label class="field-grid__wide">
        <span>Preferred venue</span>
        <select name="preferredVenue">
          <option value="">Help me choose</option>
          {eventVenueNames.map((venueName) => <option value={venueName}>{venueName}</option>)}
        </select>
      </label>
      <label class="field-grid__wide">
        <span>Tell us what you are planning</span>
        <textarea name="message" rows="5" maxlength="2000" placeholder="Functions, room requirements, food preferences or anything that helps us understand the occasion"></textarea>
      </label>
    </div>

    <label class="checkbox-field">
      <input name="consent" type="checkbox" required />
      <span>I agree that Orchha Palace may contact me about this enquiry. *</span>
    </label>

    {formEnabled && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" data-action="event-enquiry"></div>}
    <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
  </fieldset>

  <div class="lead-form__submit">
    <button class="button button--primary" type="submit" disabled={!formEnabled}>
      Send event enquiry <Icon name="ph:arrow-right" size={19} aria-hidden="true" />
    </button>
    <p class="form-message" data-lead-message aria-live="polite"></p>
  </div>

  <div class="lead-form__fallback" data-lead-fallback hidden>
    <p>We could not confirm delivery, so your enquiry may not have been recorded. Please contact the sales team directly.</p>
    <a href={`mailto:${contact.salesEmail}`}>Email {contact.salesEmail}</a>
    <a href={contact.primaryPhoneHref}>Call {contact.primaryPhone}</a>
    <a href={contact.whatsapp.event} target="_blank" rel="noreferrer">Continue on WhatsApp</a>
  </div>

  {!formEnabled && (
    <div class="lead-form__unavailable">
      <p><strong>Online enquiry is temporarily unavailable.</strong> Contact the sales team directly and we will help you plan the occasion.</p>
      <a href={`mailto:${contact.salesEmail}`}>Email {contact.salesEmail}</a>
      <a href={contact.primaryPhoneHref}>Call {contact.primaryPhone}</a>
      <a href={contact.whatsapp.event} target="_blank" rel="noreferrer">Continue on WhatsApp</a>
    </div>
  )}
</form>
