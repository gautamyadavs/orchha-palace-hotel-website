---
import { Icon } from "astro-icon/components";
import BookingForm from "@/components/BookingForm.astro";
import { contact } from "@/data/site";
import { DEFAULT_BOOKING_URL } from "@/lib/booking";
import { withBase } from "@/lib/paths";

type RoomIntent = { slug: string; name: string; code?: string };
type Props = { compact?: boolean; heading?: string; room?: RoomIntent };
const { compact = false, heading = "Plan your stay", room } = Astro.props;
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL?.trim() || DEFAULT_BOOKING_URL;
---

<section class:list={["availability", compact && "availability--compact"]} id="availability" aria-labelledby="availability-heading">
  <div class="availability__heading">
    <p class="eyebrow">Direct, secure booking</p>
    <h2 id="availability-heading">{heading}</h2>
    <p>Select your dates and guests to see current rooms and rates. Your secure booking opens in the hotel's official booking system.</p>
  </div>

  <div class="availability__desktop-form">
    <BookingForm bookingUrl={bookingUrl} source={room ? "room_availability" : "availability_bar"} room={room} />
  </div>

  <a
    class="button button--primary availability__mobile-open"
    href="#availability"
    data-booking-open
    data-booking-source={room ? "room_availability" : "availability_bar"}
    data-booking-room={room?.slug || ""}
    data-booking-room-name={room?.name || ""}
    data-booking-room-code={room?.code || ""}
  >
    Choose dates & guests <Icon name="ph:arrow-right" size={19} aria-hidden="true" />
  </a>

  <div class="availability__support">
    <span>Planning a group stay?</span>
    <a href={contact.primaryPhoneHref} data-track="call_clicked">Call</a>
    <a href={contact.whatsapp.groupStay} target="_blank" rel="noreferrer" data-track="whatsapp_clicked">WhatsApp</a>
  </div>

  <a class="availability__rooms" href={withBase("/rooms/")}>Compare rooms & suites <Icon name="ph:caret-right" size={17} aria-hidden="true" /></a>
</section>
