---
import { withBase } from "@/lib/paths";
import { Icon } from "astro-icon/components";

const venuePhotos = [
  {
    id: "wedding-venue-garden-lawn",
    src: withBase("/images/wedding-venue-garden-lawn.jpg"),
    alt: "Lush green wedding lawn at Orchha Palace with shade trees and sandstone palace architecture",
    title: "Garden Ceremony Lawn",
    caption: "Lush lawn with shaded trees, walkways, and palace pavilions",
    width: 1280,
    height: 720,
    position: "50% 45%"
  },
  {
    id: "wedding-venue-palace-colonnade",
    src: withBase("/images/wedding-venue-palace-colonnade.jpg"),
    alt: "Spacious event lawn bordered by ornate palace pavilions and manicured greenery at Orchha Palace",
    title: "Palace Colonnade Lawn",
    caption: "Spacious event lawn facing the grand palace arcade and pavilions",
    width: 1600,
    height: 893,
    position: "50% 50%"
  },
  {
    id: "wedding-venue-ceremony-lawn",
    src: withBase("/images/wedding-venue-ceremony-lawn.jpg"),
    alt: "Expansive ceremony lawn leading toward the ornate carved arch backdrop and pavilions at Orchha Palace",
    title: "Ceremony Lawn & Heritage Wall",
    caption: "Manicured lawn framed by carved stone arches and colonnades",
    width: 1600,
    height: 893,
    position: "50% 40%"
  },
  {
    id: "wedding-venue-courtyard-aerial",
    src: withBase("/images/wedding-venue-courtyard-aerial.jpg"),
    alt: "Aerial overhead view of the central garden lawn and guest cottage wings at Orchha Palace",
    title: "Central Courtyard & Lawns",
    caption: "Aerial bird's-eye view of central resort grounds and cottage wings",
    width: 1280,
    height: 853,
    position: "50% 50%"
  },
  {
    id: "wedding-venue-grand-lawn-overview",
    src: withBase("/images/wedding-venue-grand-lawn-overview.jpg"),
    alt: "Elevated panoramic view across the grand outdoor wedding lawn at Orchha Palace",
    title: "Indramani Bagh Grand Lawn",
    caption: "Panoramic aerial perspective of the 140,000 sq. ft. celebration grounds",
    width: 1600,
    height: 893,
    position: "50% 50%"
  },
  {
    id: "wedding-venue-grand-lawn-aerial",
    src: withBase("/images/wedding-venue-grand-lawn-aerial.jpg"),
    alt: "Bird's-eye aerial view of the grand 140,000 square foot Indramani Bagh wedding grounds at Orchha Palace",
    title: "Indramani Bagh Aerial Layout",
    caption: "Direct overhead view of the expansive destination wedding grounds",
    width: 1600,
    height: 893,
    position: "50% 50%"
  }
];
---

<section class="section shell venue-gallery-section" id="venue-gallery" aria-labelledby="venue-gallery-title">
  <div class="section-heading">
    <p class="eyebrow">Estate grounds & celebration lawns</p>
    <h2 id="venue-gallery-title">Venue Gallery</h2>
    <p>Explore actual photographs of our wedding lawns, palace courtyards, and grand outdoor celebration spaces at Orchha Palace.</p>
  </div>

  <div class="venue-gallery-grid" data-venue-gallery>
    {venuePhotos.map((photo, index) => (
      <figure class="venue-gallery-card">
        <button
          type="button"
          class="venue-gallery-trigger"
          data-gallery-trigger
          data-index={index}
          aria-label={`View full size: ${photo.title}`}
          aria-haspopup="dialog"
        >
          <div class="venue-gallery-media">
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
              style={`object-position: ${photo.position || '50% 50%'};`}
            />
            <span class="venue-gallery-badge" aria-hidden="true">
              <Icon name="ph:arrows-out" size={15} />
              <span>Full size</span>
            </span>
          </div>
          <figcaption class="venue-gallery-caption">
            <h3 class="venue-gallery-title">{photo.title}</h3>
            <p class="venue-gallery-desc">{photo.caption}</p>
          </figcaption>
        </button>
      </figure>
    ))}
  </div>

  <dialog class="venue-gallery-dialog" data-venue-dialog aria-label="Venue Gallery photo viewer">
    <div class="venue-gallery-dialog__container">
      <button type="button" class="venue-gallery-dialog__close" data-dialog-close aria-label="Close photo preview">
        <Icon name="ph:x" size={24} />
      </button>

      <button type="button" class="venue-gallery-dialog__arrow venue-gallery-dialog__arrow--prev" data-dialog-prev aria-label="Previous photo">
        <Icon name="ph:caret-left-bold" size={24} />
      </button>

      <button type="button" class="venue-gallery-dialog__arrow venue-gallery-dialog__arrow--next" data-dialog-next aria-label="Next photo">
        <Icon name="ph:caret-right-bold" size={24} />
      </button>

      <div class="venue-gallery-dialog__image-wrap">
        <img src="" alt="" data-dialog-image />
      </div>

      <div class="venue-gallery-dialog__footer">
        <div class="venue-gallery-dialog__meta">
          <p class="venue-gallery-dialog__title" data-dialog-title></p>
          <p class="venue-gallery-dialog__desc" data-dialog-desc></p>
        </div>
        <span class="venue-gallery-dialog__counter" data-dialog-counter></span>
      </div>
    </div>
  </dialog>
</section>

<script is:inline define:vars={{ venuePhotos }}>
  (() => {
    const dialog = document.querySelector('[data-venue-dialog]');
    if (!dialog) return;

    const dialogImg = dialog.querySelector('[data-dialog-image]');
    const dialogTitle = dialog.querySelector('[data-dialog-title]');
    const dialogDesc = dialog.querySelector('[data-dialog-desc]');
    const dialogCounter = dialog.querySelector('[data-dialog-counter]');
    const closeBtn = dialog.querySelector('[data-dialog-close]');
    const prevBtn = dialog.querySelector('[data-dialog-prev]');
    const nextBtn = dialog.querySelector('[data-dialog-next]');
    const triggers = document.querySelectorAll('[data-gallery-trigger]');

    let currentIndex = 0;

    function renderPhoto(index) {
      if (index < 0) index = venuePhotos.length - 1;
      if (index >= venuePhotos.length) index = 0;
      currentIndex = index;

      const photo = venuePhotos[currentIndex];
      if (dialogImg) {
        dialogImg.src = photo.src;
        dialogImg.alt = photo.alt;
      }
      if (dialogTitle) dialogTitle.textContent = photo.title;
      if (dialogDesc) dialogDesc.textContent = photo.caption;
      if (dialogCounter) dialogCounter.textContent = `${currentIndex + 1} / ${venuePhotos.length}`;
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const index = parseInt(trigger.getAttribute('data-index') || '0', 10);
        renderPhoto(index);
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener('click', () => dialog.close());

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      renderPhoto(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      renderPhoto(currentIndex + 1);
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        renderPhoto(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        renderPhoto(currentIndex + 1);
      }
    });
  })();
</script>

<style>
  .venue-gallery-section {
    padding-top: clamp(32px, 5vw, 64px);
    border-top: 1px solid var(--line-soft, #ebe5df);
  }

  .venue-gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: clamp(24px, 4vw, 36px);
  }

  @media (min-width: 640px) {
    .venue-gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }

  @media (min-width: 960px) {
    .venue-gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }
  }

  .venue-gallery-card {
    margin: 0;
    overflow: hidden;
    background: var(--surface, #ffffff);
    border: 1px solid var(--line, #e2dad1);
    border-radius: var(--radius, 4px);
    box-shadow: 0 2px 8px rgba(32, 20, 16, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .venue-gallery-card:hover {
    transform: translateY(-2px);
    border-color: var(--sand-dark, #b88656);
    box-shadow: 0 8px 24px rgba(32, 20, 16, 0.08);
  }

  .venue-gallery-trigger {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
    height: 100%;
  }

  .venue-gallery-trigger:focus-visible {
    outline: 2px solid var(--maroon, #4f0f16);
    outline-offset: 2px;
  }

  .venue-gallery-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--paper, #f7f4ef);
  }

  .venue-gallery-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .venue-gallery-card:hover .venue-gallery-media img {
    transform: scale(1.03);
  }

  .venue-gallery-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(28, 21, 18, 0.82);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    backdrop-filter: blur(4px);
    opacity: 0.9;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  .venue-gallery-card:hover .venue-gallery-badge {
    opacity: 1;
    background: var(--maroon, #4f0f16);
  }

  .venue-gallery-caption {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 1 auto;
    background: #ffffff;
    border-top: 1px solid var(--line-soft, #f0eae3);
  }

  .venue-gallery-title {
    margin: 0;
    font-family: var(--font-display, Cormorant Garamond, serif);
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 600;
    color: var(--maroon, #4f0f16);
  }

  .venue-gallery-desc {
    margin: 0;
    font-family: var(--font-body, Manrope, sans-serif);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink-soft, #6b635b);
  }

  /* Lightbox Dialog */
  .venue-gallery-dialog {
    width: min(95vw, 1200px);
    max-height: 94vh;
    padding: 0;
    margin: auto;
    border: 0;
    border-radius: 8px;
    background: #171310;
    color: #ffffff;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }

  .venue-gallery-dialog::backdrop {
    background: rgba(15, 10, 8, 0.88);
    backdrop-filter: blur(6px);
  }

  .venue-gallery-dialog__container {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: min(75vh, 720px);
    max-height: 94vh;
  }

  .venue-gallery-dialog__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(28, 21, 18, 0.82);
    color: #ffffff;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .venue-gallery-dialog__close:hover {
    background: var(--maroon, #4f0f16);
    border-color: rgba(255, 255, 255, 0.7);
  }

  .venue-gallery-dialog__arrow {
    position: absolute;
    top: 48%;
    transform: translateY(-50%);
    z-index: 10;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    background: rgba(28, 21, 18, 0.82);
    color: #ffffff;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .venue-gallery-dialog__arrow:hover {
    background: var(--maroon, #4f0f16);
    border-color: rgba(255, 255, 255, 0.7);
  }

  .venue-gallery-dialog__arrow--prev {
    left: 14px;
  }

  .venue-gallery-dialog__arrow--next {
    right: 14px;
  }

  .venue-gallery-dialog__image-wrap {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 50px 20px 20px;
    min-height: 0;
    overflow: hidden;
  }

  .venue-gallery-dialog__image-wrap img {
    max-width: 100%;
    max-height: calc(88vh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
  }

  .venue-gallery-dialog__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 24px;
    background: rgba(23, 19, 16, 0.96);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .venue-gallery-dialog__title {
    margin: 0;
    font-family: var(--font-display, Cormorant Garamond, serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: #ffffff;
  }

  .venue-gallery-dialog__desc {
    margin: 3px 0 0;
    font-family: var(--font-body, Manrope, sans-serif);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .venue-gallery-dialog__counter {
    font-family: var(--font-body, Manrope, sans-serif);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .venue-gallery-dialog {
      width: 100vw;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
    }

    .venue-gallery-dialog__container {
      height: 100dvh;
      min-height: 100dvh;
      max-height: 100dvh;
    }

    .venue-gallery-dialog__arrow {
      width: 38px;
      height: 38px;
    }

    .venue-gallery-dialog__arrow--prev {
      left: 8px;
    }

    .venue-gallery-dialog__arrow--next {
      right: 8px;
    }

    .venue-gallery-dialog__image-wrap {
      padding: 56px 8px 12px;
    }

    .venue-gallery-dialog__image-wrap img {
      max-height: calc(100dvh - 160px);
    }

    .venue-gallery-dialog__footer {
      padding: 12px 16px;
    }
  }
</style>
