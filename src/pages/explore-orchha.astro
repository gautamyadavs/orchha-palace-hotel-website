---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ItineraryPlanner from "@/components/ItineraryPlanner.astro";
import { getSiteData } from "@/lib/cms";
import { withBase } from "@/lib/paths";
import { contact } from "@/data/site";
const { activities, itineraryTemplates, media } = await getSiteData();
const photograph = media.find(asset => asset.id === "hero-orchha")!;
---
<BaseLayout stickyBooking={false} title="Plan 2 or 3 nights in Orchha | Orchha Palace" description="Build your own two- or three-night stay with temples, heritage walks, Betwa adventures, riverside dining at Betwa View Dining and time at Orchha Palace.">
  <div class="explore-intro shell"><div><h1>Your time in Orchha</h1><p>Palaces, temple evenings and the Betwa. Discover a suggested stay, then make it your own.</p></div><img src={photograph.src} alt={photograph.alt} width="960" height="540" fetchpriority="high" /></div>
  <div class="shell explore-planner-shell"><ItineraryPlanner activities={activities} templates={itineraryTemplates} /></div>
  <section class="section shell riverside-dining" aria-labelledby="explore-betwa-dining"><div><p class="eyebrow">Stay for the evening</p><h2 id="explore-betwa-dining">A table by the Betwa</h2></div><div><p>Pair the Royal Chhatris and Betwa sunset with dinner at <strong>Betwa View Dining at Orchha Resort, by the river</strong>. Our sister property's riverside setting is a lovely place to slow down after exploring Orchha.</p><p>You'll find this evening in both suggested stays. Ask about a river-facing table, current service and transport back to Orchha Palace.</p><a class="text-link" href={withBase("/dining/#betwa-view-dining")}>Discover Betwa View Dining →</a></div></section>
  <section class="section section--paper"><div class="shell"><h2>Arrive with a little help</h2><p>Ask our team about transfers, local guides and arrangements for your chosen experiences.</p><div class="choice-links"><a href={contact.maps} target="_blank" rel="noreferrer">Get directions ↗</a><a href={contact.whatsapp.stay} target="_blank" rel="noreferrer">Ask the hotel on WhatsApp ↗</a></div></div></section>
</BaseLayout>
