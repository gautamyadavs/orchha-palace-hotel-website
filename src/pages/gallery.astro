---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RoomGallery from "@/components/RoomGallery.astro";
import { getSiteData } from "@/lib/cms";
const { media } = await getSiteData();
const categories = [{ id: "property", name: "The hotel" }, { id: "room", name: "Rooms & suites" }, { id: "dining", name: "Dining" }, { id: "wellness", name: "Wellness" }, { id: "venue", name: "Events" }, { id: "destination", name: "Orchha" }].filter(c => media.some(m => m.category === c.id));
---
<BaseLayout title="Photo Gallery | Orchha Palace" description="Look around Orchha Palace: rooms, gardens, dining, wellness and event settings.">
  <div class="page-intro shell"><p class="eyebrow">A closer look</p><h1>Picture your time here</h1><p>Choose a part of the hotel to explore. Open any photograph for a full-screen view.</p></div>
  <section class="shell section--compact" data-property-gallery><div class="gallery-filters" hidden>{categories.map((category,i) => <button class="button button--secondary button--small" type="button" data-gallery-filter={category.id} aria-pressed={i === 0}>{category.name}</button>)}</div>{categories.map(category => <section data-gallery-category={category.id}><h2>{category.name}</h2><RoomGallery room={`property-${category.id}`} label={category.name.toLowerCase()} images={media.filter(m => m.category === category.id)} /></section>)}</section>
</BaseLayout>
<script>
const root=document.querySelector<HTMLElement>("[data-property-gallery]");
if(root){
 const controls=root.querySelector<HTMLElement>(".gallery-filters")!;controls.hidden=false;
 const buttons=[...root.querySelectorAll<HTMLButtonElement>("[data-gallery-filter]")];
 const select=(id:string)=>{root.querySelectorAll<HTMLElement>("[data-gallery-category]").forEach(panel=>panel.hidden=panel.dataset.galleryCategory!==id);buttons.forEach(button=>button.setAttribute("aria-pressed",String(button.dataset.galleryFilter===id)));};
 buttons.forEach(button=>button.addEventListener("click",()=>select(button.dataset.galleryFilter!)));select(buttons[0].dataset.galleryFilter!);
}
</script>
