---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import AvailabilityBar from "@/components/AvailabilityBar.astro";
import { getSiteData } from "@/lib/cms";

const { amenities, media } = await getSiteData();
const pool = media.find((item) => item.id === "pool") || media[0];
---

<BaseLayout title="Hotel & Amenities | Orchha Palace" description="Explore Orchha Palace's outdoor pool, spa, fitness centre, 4,100 sq. ft. Kids Zone, dining, concierge and guest services." image={pool.src}>
  <PageHero eyebrow="Hotel & amenities" title="Everything a good stay needs" copy="Wellness, family time, dining and useful service—close enough to enjoy without planning your day around it." image={pool.src} alt={pool.alt} />

  <section class="section shell">
    <SectionHeading eyebrow="At the hotel" title="Spend the day entirely your way" copy="Some services, treatments and private instruction require advance booking; the concierge can arrange them before or during your stay." />
    <div class="amenity-grid">
      {amenities.map((item) => <article class="amenity-card"><span class="amenity-card__icon"><Icon name={item.icon} size={24} aria-hidden="true" /></span><h3>{item.name}</h3><p>{item.description}</p></article>)}
    </div>
  </section>

  <section class="section section--paper">
    <div class="shell editorial-split">
      <div class="editorial-split__image"><img src={pool.src} alt={pool.alt} width="1000" height="1100" loading="lazy" /></div>
      <div class="editorial-split__copy"><p class="eyebrow">Poolside hours</p><h2>Swim, stretch out, slow down</h2><p>The freeform outdoor pool includes an inbuilt stage and a sun deck for long, unhurried afternoons. Poolside refreshments are available through the hotel team.</p><a class="text-link" href="#availability" data-booking-open data-booking-source="amenities">Plan a stay <Icon name="ph:calendar-check" size={18} /></a></div>
    </div>
  </section>

  <section class="section shell"><AvailabilityBar compact heading="Make the hotel yours for a while" /></section>
</BaseLayout>
