---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { betwaViewDining, betwaViewDiningSchema } from "@/data/betwa-view-dining";
import { contact } from "@/data/site";
import { getSiteData } from "@/lib/cms";
import { withBase } from "@/lib/paths";

const { dining, media } = await getSiteData();
const food = media.find((item) => item.id === "food") || dining[0].image;
const groupDining = media.find((item) => item.id === "dining-groups") || food;
const schema = dining.map((venue) => ({
  "@context": "https://schema.org",
  "@type": venue.slug === "madira" ? "BarOrPub" : "Restaurant",
  name: venue.name,
  description: venue.description,
  servesCuisine: venue.type,
  telephone: contact.primaryPhoneSchema,
  parentOrganization: { "@type": "Hotel", name: "Orchha Palace Hotel & Convention Centre" }
}));
---

<BaseLayout title="Dining in Orchha | Orchha Palace & Betwa View Dining" description="Dine at Annajal, Dragon and Madira at Orchha Palace, or enjoy a riverside evening at Betwa View Dining at our sister property, Orchha Resort, by the river." image={food.src} schema={[...schema, betwaViewDiningSchema]}>
  <PageHero eyebrow="Dining" title="Three places to follow your appetite" copy="Regional flavours, global comfort, Pan-Asian favourites and an easy evening bar—all within the hotel." image={food.src} alt={food.alt} />

  <section class="section shell">
    <SectionHeading eyebrow="Choose your setting" title="From breakfast to a final drink" copy="Opening hours and service formats may change around events; the front desk can confirm today's schedule." />
    <div class="dining-grid">
      {dining.map((venue) => (
        <article class="dining-card">
          <img src={venue.image.src} alt={venue.image.alt} width="960" height="740" loading="lazy" />
          <div class="dining-card__body">
            <p class="eyebrow">{venue.type}</p>
            <h2 style="font-size:clamp(2.5rem,7vw,4rem)">{venue.name}</h2>
            <p>{venue.description}</p>
            <div class="dining-card__meta"><span>{venue.location}</span>{venue.capacity && <span>{venue.capacity}</span>}</div>
            <a class="text-link" href={`https://wa.me/919516006201?text=${encodeURIComponent(`Hello Orchha Palace, I would like to ask about a table at ${venue.name}.`)}`} target="_blank" rel="noreferrer">Ask about a table →</a>
            <ul class="feature-list" style="margin-top:16px">{venue.highlights.map((item) => <li><Icon name="ph:check" size={17} /> {item}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--paper" id="betwa-view-dining" aria-labelledby="betwa-dining-heading">
    <div class="shell riverside-dining">
      <div><p class="eyebrow">At our sister property · Kanchan Ghat</p><h2 id="betwa-dining-heading">{betwaViewDining.name}</h2><p class="riverside-dining__property">At {betwaViewDining.property}</p></div>
      <div><p>Let your evening linger by the Betwa. After visiting the Royal Chhatris and watching the sunset, continue to Betwa View Dining for a relaxed meal with river views at our sister property, Orchha Resort, by the river.</p><p>Ask for a river-facing table and confirm the day's service. Our team can help plan your visit and transport back to Orchha Palace; dining is arranged separately.</p><p class="small-copy">{betwaViewDining.address}</p><div class="choice-links"><a href={`tel:${betwaViewDining.telephone}`}>Call Betwa View Dining · {betwaViewDining.phone}</a><a href={betwaViewDining.maps} target="_blank" rel="noreferrer">Directions ↗</a><a href={betwaViewDining.propertyUrl} target="_blank" rel="noreferrer">Explore Orchha Resort ↗</a></div><a class="text-link" href={withBase("/explore-orchha/")}>Make it part of your Orchha stay →</a></div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="shell editorial-split">
      <div class="editorial-split__image"><img src={groupDining.src} alt={groupDining.alt} width="1800" height="1079" loading="lazy" /></div>
      <div class="editorial-split__copy">
        <p class="eyebrow eyebrow--light">A table for the occasion</p>
        <h2>Dining for groups and celebrations</h2>
        <p style="color:rgba(255,255,255,.7)">Planning a wedding, conference or private dinner? The culinary team can shape menus and service around the event format and guest list.</p>
        <a class="text-link text-link--light" href={withBase("/weddings-events/#event-enquiry")}>Plan an event menu <Icon name="ph:arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section shell">
    <SectionHeading align="center" eyebrow="Reserve or ask" title="Speak with the hotel team" copy="For restaurant hours, dietary requests and group dining, contact the hotel directly." />
    <div style="display:flex;justify-content:center;gap:12px;flex-wrap:wrap">
      <a class="button button--primary" href={contact.primaryPhoneHref} data-track="call_clicked">Call the hotel <Icon name="ph:phone" size={18} /></a>
      <a class="button button--secondary" href={contact.whatsapp.stay} target="_blank" rel="noreferrer" data-track="whatsapp_clicked">WhatsApp <Icon name="ph:whatsapp-logo" size={18} /></a>
    </div>
  </section>
</BaseLayout>
