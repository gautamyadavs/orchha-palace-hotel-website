---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AvailabilityBar from "@/components/AvailabilityBar.astro";
import PalaceHero from "@/components/PalaceHero.astro";
import { contact } from "@/data/site";
import { getSiteData } from "@/lib/cms";
import { withBase } from "@/lib/paths";
const { media } = await getSiteData();
const byId = (id: string) => media.find(m => m.id === id)!;
const schema = { "@context": "https://schema.org", "@type": "Hotel", name: "Orchha Palace Hotel & Convention Centre", url: "https://orchhapalace.com", telephone: contact.primaryPhoneSchema, address: { "@type": "PostalAddress", streetAddress: "Sawant Nagar, Near Ramraja Temple", addressLocality: "Orchha", addressRegion: "Madhya Pradesh", postalCode: "472246", addressCountry: "IN" } };
---
<BaseLayout title="Orchha Palace | A royal welcome awaits" description="Find your room, plan two or three nights in Orchha, or bring your wedding or corporate event to our 12-acre palace hotel." schema={schema} image={withBase("/images/palace-hero.webp")} preloadImage="/images/palace-hero.avif" preloadMobileImage="/images/palace-hero.avif" preloadImageType="image/avif" immersive="desktop">
  <PalaceHero image={withBase("/images/palace-hero.webp")} imageHeight={990} avifImage={withBase("/images/palace-hero.avif")} alt="The sun setting over Orchha Palace's grand entrance and formal gardens" eyebrow="Orchha · Madhya Pradesh" title="A royal welcome." emphasis="A world of your own." description="Palace courtyards, generous rooms and the quiet pleasure of time well spent." action="Discover your stay" href="#home-rooms" />
  <section class="shell home-reservations" aria-label="Plan your palace stay"><AvailabilityBar heading="Your stay at the palace" compact /></section>
  <section class="section shell rooms-editorial" aria-labelledby="home-rooms">
    <figure><img src={byId("rooms-editorial").src} srcset={`${byId("rooms-editorial").mobileSrc} 800w, ${byId("rooms-editorial").src} 1920w`} sizes="(max-width: 767px) calc(100vw - 32px), (max-width: 1312px) calc(100vw - 64px), 1248px" alt={byId("rooms-editorial").alt} width="1920" height="1078" loading="lazy" /><figcaption>Palace details, framed by green</figcaption></figure>
    <div class="rooms-editorial__copy"><h2 id="home-rooms">Rooms + suites</h2><p>Generous proportions, rich textures and the quiet comfort of a palace stay. Choose a room for restful days, or make the Presidential Suite your own with private living and dining spaces. Whatever brings you to Orchha, there is room to settle in.</p><a class="rooms-editorial__link" href={withBase("/rooms/")}>View rooms + suites <span aria-hidden="true">→</span></a></div>
  </section>
  <section class="section section--paper"><div class="shell"><div class="section-topline"><div><p class="eyebrow">Enjoy the hours in between</p><h2>Stay in. Slow down.</h2></div><a class="text-link" href={withBase("/hotel-amenities/")}>At the hotel →</a></div><div class="benefit-grid">
    <a class="benefit-card" href={withBase("/hotel-amenities/")}><img src={byId("pool").src} alt={byId("pool").alt} width="640" height="420" loading="lazy" /><h3>Poolside, at your pace</h3><p>A swim, a garden stroll or a spa appointment.</p></a>
    <a class="benefit-card" href={withBase("/dining/")}><img src={byId("food").src} alt={byId("food").alt} width="640" height="420" loading="lazy" /><h3>Follow your appetite</h3><p>Annajal, Dragon and a relaxed pause at Patio Cafe.</p></a>
  </div></div></section>
  <section class="section shell"><div class="itinerary-teaser"><img src={byId("hero-orchha").src} alt={byId("hero-orchha").alt} width="640" height="500" loading="lazy" /><div><p class="eyebrow">Make time for Orchha</p><h2>Some places deserve another day.</h2><p>Temple evenings, palace courtyards and a sunset by the Betwa. Start with a relaxed plan and make it yours.</p><div class="choice-links"><a href={withBase("/explore-orchha/?nights=2#planner")}>2 nights · 3 days →</a><a href={withBase("/explore-orchha/?nights=3#planner")}>3 nights · 4 days →</a></div></div></div></section>
  <section class="section section--paper"><div class="shell"><p class="eyebrow">Bring people together</p><h2>A place for your occasion</h2><div class="event-entry-grid">
    <a href={withBase("/weddings/")} class="event-entry"><img src={byId("wedding-showcase").src} alt={byId("wedding-showcase").alt} width="640" height="440" loading="lazy" /><div><h3>Weddings & celebrations</h3><p>Find a setting for every chapter of your celebration.</p><span class="text-link">Imagine your wedding →</span></div></a>
    <a href={withBase("/corporate-events/")} class="event-entry"><img src={byId("boardroom").src} alt={byId("boardroom").alt} width="640" height="440" loading="lazy" /><div><h3>Meetings & corporate events</h3><p>Choose your layout, shortlist a space and plan the details.</p><span class="text-link">Plan your event →</span></div></a>
  </div></div></section>
  <section class="section shell arrival-section"><div><p class="eyebrow">Before you arrive</p><h2>A few useful details</h2><a class="text-link" href={withBase("/contact/")}>Contact & directions →</a></div><div class="disclosures"><details><summary>When can I check in and out?</summary><p>Check-in is from 2pm; check-out is by 10am. Ask reservations about early arrival or luggage arrangements.</p></details><details><summary>How do I arrange transfers or activities?</summary><p>Contact the hotel with your travel details. Our team can help confirm local transport, guides and activity availability.</p><a href={contact.whatsapp.stay} target="_blank" rel="noreferrer">Ask on WhatsApp</a></details></div></section>
</BaseLayout>
