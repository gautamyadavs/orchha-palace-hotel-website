---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EventLeadForm from "@/components/EventLeadForm.astro";
import { withBase } from "@/lib/paths";
---
<BaseLayout title="Plan your occasion | Orchha Palace" description="Choose wedding and celebration planning or meetings and corporate events at Orchha Palace." journey="event">
  <section class="page-intro shell"><p class="eyebrow">Bring people together</p><h1>What are you planning?</h1><div class="event-entry-grid"><a class="button button--primary" href={withBase("/weddings/")}>Weddings & celebrations →</a><a class="button button--secondary" href={withBase("/corporate-events/")}>Meetings & corporate events →</a></div></section>
  <section class="section shell" id="event-enquiry"><h2>Start an enquiry</h2><EventLeadForm /></section>
</BaseLayout>
