---
import { Icon } from "astro-icon/components";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SuiteReel from "@/components/SuiteReel.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AvailabilityBar from "@/components/AvailabilityBar.astro";
import RoomCard from "@/components/RoomCard.astro";
import RoomGallery from "@/components/RoomGallery.astro";
import AssistedReservation from "@/components/AssistedReservation.astro";
import { contact } from "@/data/site";
import { getSiteData } from "@/lib/cms";
import type { Room } from "@/lib/types";

export async function getStaticPaths() {
  const { rooms } = await getSiteData();
  return rooms.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}

type Props = { room: Room };
const { room } = Astro.props;
const { rooms } = await getSiteData();
const related = rooms.filter((item) => item.slug !== room.slug).slice(0, 2);
const assisted = room.bookingMode === "assisted";
const schema = {
  "@context": "https://schema.org",
  "@type": "HotelRoom",
  name: room.name,
  description: room.description,
  floorSize: room.size,
  bed: { "@type": "BedDetails", typeOfBed: room.bed },
  containedInPlace: { "@type": "Hotel", name: "Orchha Palace Hotel & Convention Centre" }
};
---

<BaseLayout title={`${room.name} | Orchha Palace`} description={room.description} image={room.image.src} schema={schema} journey={assisted ? "assisted-suite" : "stay"}>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Rooms", href: "/rooms/" }, { label: room.name }]} />
  <section class="detail-header shell"><p class="eyebrow">{room.eyebrow}</p><h1>{room.name}</h1><p>{room.description}</p>
    <div class="choice-links">{assisted ? <><a class="button button--primary" href={contact.primaryPhoneHref} data-sticky-suppress>Call to reserve</a><a class="button button--secondary" href={contact.whatsapp.presidentialSuite} target="_blank" rel="noreferrer" data-sticky-suppress>WhatsApp</a></> : <a class="button button--primary" href="#availability" data-booking-open data-booking-source="room_detail" data-booking-room={room.slug} data-booking-room-name={room.name} data-booking-room-code={room.maximojoRoomCode || ""}>Check live rates →</a>}</div>
    <dl class="detail-facts"><div><dt>Space</dt><dd>{room.size}</dd></div><div><dt>Bed</dt><dd>{room.bed}</dd></div><div><dt>Best for</dt><dd>{room.idealFor}</dd></div><div><dt>Bathroom</dt><dd>{room.bathroom}</dd></div><div><dt>Aspect</dt><dd>{room.view}</dd></div></dl>
  </section>

  <section class="section section--paper">
    <div class="shell">
      <div class="room-gallery-heading">
        <div><p class="eyebrow">Room gallery</p><h2>{assisted ? "Explore the suite before you call" : "Look around before you book"}</h2></div>
        <p>Explore the bedroom, living spaces and details of your stay.</p>
      </div>
      <div class:list={[assisted && "suite-media"]}><RoomGallery room={room.slug} images={room.gallery} />{assisted && <SuiteReel room={room} />}</div>
    </div>
  </section>

  <section class="section shell">
    <div class="disclosures">{[["Highlights",room.highlights],["Room amenities",room.amenities],["Included",room.inclusions]].map(([title,items]) => <details><summary>{title}</summary><ul class="feature-list">{(items as string[]).map(item => <li><Icon name="ph:check" size={18} /> {item}</li>)}</ul></details>)}</div>
  </section>

  <section class="section section--paper"><div class="shell">
    {assisted ? <AssistedReservation /> : <AvailabilityBar compact heading={`Check ${room.shortName} availability`} room={{ slug: room.slug, name: room.name, code: room.maximojoRoomCode }} />}
  </div></section>

  <section class="section shell">
    <p class="eyebrow">Also consider</p>
    <div class="room-grid">{related.map((item) => <RoomCard room={item} showBookingAction={!assisted} />)}</div>
  </section>
</BaseLayout>
