---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RoomChooser from "@/components/RoomChooser.astro";
import AvailabilityBar from "@/components/AvailabilityBar.astro";
import { getSiteData } from "@/lib/cms";
const { rooms } = await getSiteData();
---
<BaseLayout title="Rooms & Suites | Orchha Palace" description="Compare beds, bathrooms and space across Standard, Deluxe and the Presidential Suite at Orchha Palace.">
  <div class="page-intro shell"><p class="eyebrow">Make yourself at home</p><h1>Find your kind of stay</h1><p>Generous rooms, thoughtful comforts. Compare the details, then choose your dates.</p></div>
  <div class="shell section--compact"><RoomChooser rooms={rooms} /></div>
  <section class="section section--paper"><div class="shell"><AvailabilityBar compact heading="Your dates. Your time away." /></div></section>
</BaseLayout>
